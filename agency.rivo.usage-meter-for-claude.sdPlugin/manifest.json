{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "agency.rivo.usage-meter-for-claude",
	"Name": "Usage Meter for Claude",
	"Version": "3.1.1.0",
	"Author": "Rivo Agency",
	"URL": "https://github.com/developerscompany/usage-meter-for-claude",
	"SupportURL": "https://github.com/developerscompany/usage-meter-for-claude/issues",
	"Description": "Claude usage on your Stream Deck: 5-hour and weekly plan limits for every model, peak hours, cloud and API credit, tokens and API-equivalent cost of Claude Code, cache hits, model mix, session context, streak, service status, and a key that starts Claude Code. Unofficial; not affiliated with Anthropic.",
	"Category": "Usage Meter for Claude",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"UUID": "agency.rivo.usage-meter-for-claude.limit5h",
			"Name": "5-Hour Limit",
			"Icon": "imgs/actions/limit5h/icon",
			"Tooltip": "Claude plan 5-hour (session) limit: what's left or used, 10 display styles. Hold to refresh.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/limit5h/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "agency.rivo.usage-meter-for-claude.limit7d",
			"Name": "Weekly Limit",
			"Icon": "imgs/actions/limit7d/icon",
			"Tooltip": "Claude plan weekly limit: all models, or Fable, Opus, Sonnet or Haiku alone. 10 display styles. Hold to refresh.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/limit7d/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "agency.rivo.usage-meter-for-claude.limits",
			"Name": "Both Limits",
			"Icon": "imgs/actions/limits/icon",
			"Tooltip": "5-hour and weekly limits on one key. Hold to refresh.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
